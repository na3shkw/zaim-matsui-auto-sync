HEADLESS=false
LOG_LEVEL=info

# コンテナ実行ユーザーのUID/GID（ホスト側のUID/GIDに合わせる）
# PUID=1000
# PGID=1000

# 松井証券の認証コードを受信するGoogleメッセージ会話のURL
GOOGLE_MESSAGE_MATSUI_CONVERSATION_URL=https://messages.google.com/web/conversations/*******

# ログイン方式の選択（password または passkey、デフォルト: password）
# MATSUI_LOGIN_METHOD=password

# 松井証券のログインIDとパスワード（パスワードログイン時のみ使用）
MATSUI_LOGIN_ID=
MATSUI_PASSWORD=

# 認証コード関連設定（パスワードログイン時のみ使用）
AUTH_CODE_POLLING_INTERVAL_SECONDS=10
AUTH_CODE_POLLING_TIMEOUT_SECONDS=60
AUTH_CODE_MAX_RETRY_ATTEMPTS=3

# Zaimへの収入登録方式（api または web、デフォルト: api）
# Zaim APIは2026年12月7日に提供終了するため、以降は web を指定する
# ZAIM_REGISTER_METHOD=api

# くふうアカウント（Zaim）のログイン情報（ZAIM_REGISTER_METHOD=web の時のみ使用）
# ZAIM_TOTP_SECRET には2段階認証（認証アプリ）設定時に表示されるシークレットキーを指定する
ZAIM_EMAIL=
ZAIM_PASSWORD=
ZAIM_TOTP_SECRET=

# Zaim API認証用のコンシューマーキーとコンシューマーシークレット
ZAIM_CONSUMER_KEY=
ZAIM_CONSUMER_SECRET=

# Docker イメージのバージョン指定（指定しない場合は latest を使用）
# IMAGE_TAG=1.2.3

# ブラウザの User-Agent（指定しない場合はブラウザの既定値を使用）
# BROWSER_USER_AGENT=
